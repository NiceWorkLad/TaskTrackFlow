<div class="task-list task-grid">
  <% @tasks.each do |task| %>
    <div class="task-item task-card-display-list">
      <%= link_to task_path(task), class: "task-card__link" do %>
        <div class="task-display-list">
        <p class="task-card__title"><%= task.title %></p>
        <div class="task-card-list-info">
        <time class="task-card__created" datetime="<%= task.created_at.iso8601 %>"><%= time_ago_in_words(task.created_at) %> ago</time>
        <p><%= task.status%></p>
        </div>

        </div>
      <% end %>
    </div>
  <% end %>
</div>
