<div class="comment-box" id="comment_<%= comment.id %>">

  <div class="comment-user">
    <h4 class="comment-username"><%= comment.user.username %></h4>

    <p class="comment-time">
      <% elapsed_seconds = (Time.current - comment.created_at).to_i %>

      <% if elapsed_seconds < 1.hour %>
        <%= pluralize([elapsed_seconds / 1.minute, 1].max, "min") %> ago
      <% elsif elapsed_seconds < 1.day %>
        <%= pluralize(elapsed_seconds / 1.hour, "hour") %> ago
      <% else %>
        <%= pluralize(elapsed_seconds / 1.day, "day") %> ago
      <% end %>
    </p>
  </div>

  <div class="comment-body">
    <p><%= comment.body %></p>

    <div class="comment-buttons">

      <% if false %>
        <button
          class="base-btn-2-mini"
          type="button"
          data-action="visibility#show"
          data-visibility-targets-param="comment-form-<%= comment.id %>">
          Reply
        </button>
      <% end %>

      <span hidden data-controller="viewer" data-viewer-owner-id-value="<%= comment.user_id %>">
        <%= button_to 'X',
            task_comment_path(comment.task, comment),
            method: :delete,
            class: 'base-btn-2-mini btn-destroy' %>
      </span>

    </div>
  </div>

</div>
