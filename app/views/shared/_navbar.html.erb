<nav class="navbar">
  <%= link_to "Task Tracker", root_path, class: "navbar-brand" %>

  <ul class="navbar-nav">
    <li><%= link_to "Public", public_tasks_path, class: "nav-link" %></li>
    <li><%= link_to "Docs", pages_docs_path, class: "nav-link" %></li>
    <li><%= link_to "Dev", pages_dev_path, class: "nav-link" %></li>

    <% if user_signed_in? %>
      <li><%= link_to "New", new_task_path, class: "nav-link" %></li>
      <li><%= link_to "My Tasks", tasks_path, class: "nav-link" %></li>

      <li>
        <div class="user-profile-card">
          <div class="user-avatar-circle">
            <%= render "shared/icons/user" %>
          </div>
          <div class="user-info">
            <span class="user-email"><%= current_user.email %></span>
            <%= link_to "Profile", pages_profile_path, class: "logout-link" %>
          </div>
        </div>
      </li>
    <% else %>
      <li>
        <%= link_to new_user_session_path, class: "user-profile-card" do %>
          <div class="user-avatar-circle">
            <%= render "shared/icons/user" %>
          </div>
          <div class="user-info">
            <span class="user-label">Welcome</span>
            <span class="user-email">Login / Sign up</span>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
