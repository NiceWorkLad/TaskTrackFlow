<h1 class="task-list-title">Task List</h1>
<div class="task-list">
  <% @tasks.each do |task| %>
    <%= link_to task_path(task), class: "task-item" do %>
      <h2 class="task-title"><%= task.title %></h2>
      <p class="task-description"><%= task.description %></p>
      <p class="task-status <%= task.completed ? 'task-status--completed' : 'task-status--pending' %>">
        Status: <%= task.completed ? "Completed" : "Pending" %>
      </p>
    <% end %>
  <% end %>
</div>
