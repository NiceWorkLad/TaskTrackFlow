<div class="task-list task-display-list-container">
  <% tasks.each do |task| %>
    <div class="task-item task-card-display-list">
      <%= link_to task_path(task), class: "task-card__link", data: { turbo_frame: "_top" } do %>
        <div class="task-display-list">
          <p class="task-card__title"><%= task.title %></p>
          <div class="task-card-list-info">
            <time class="task-card__created" datetime="<%= task.created_at.iso8601 %>"><%= time_ago_in_words(task.created_at) %> ago</time>
            <p class="status-tag"><%= task.status %></p>
          </div>
        </div>
      <% end %>
      <% if current_user && task.user == current_user %>
        <%= link_to "Edit", edit_task_path(task), class: "btn btn-edit", data: { turbo_frame: "_top" } %>
      <% end %>
    </div>
  <% end %>
</div>
