<div class="page-show">
  <h1 class="page-show-title"><%= @task.title %></h1>
  <p class="page-show-description"><%= @task.description %></p>
  <% if @task.body.present? %>
  <div class="page-show-markdown-preview">
    <%= raw MarkdownRenderer.render(@task.body) %>
  </div>
  <% end %>
  <h6><%= @task.status %></h6>
  <% if current_user == @task.user %>
    <%= link_to 'Edit', edit_task_path(@task), class: 'btn-edit' %>
  <% end %>
</div>
