<%= form_with model: [@task, Comment.new], class: "comment-form" do |form| %>
  <div id="comment-form-<%= @task.id%>" class="comment-box" data-controller="visibility">
    <div class="comment-user">
      <h4 class="comment-username"><%= current_user.username %></h4>
    </div>

    <%= form.text_area :body,
          placeholder: "Write a comment...",
          class: "comment-body",
          required: true %>

    <div class="comment-buttons">
      <%= form.submit "Comment", class: "base-btn-2-mini" %>
      <button
    type="button"
    data-action="visibility#hide"
    data-visibility-targets-param="comment-form-<%= @task.id%>"
    class="base-btn-2-mini">
    Cancel
    </button>
    </div>
  </div>
<% end %>