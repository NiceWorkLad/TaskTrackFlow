<nav class="navbar">
  <%= link_to "Task Track Flow", root_path, class: "navbar-brand" %>

  <ul class="navbar-nav footer-links">
    <li><%= link_to "Public", public_tasks_path, class: "nav-link" %></li>
    <li><%= link_to "Docs", pages_docs_path, class: "nav-link" %></li>

    <% if user_signed_in? %>
      <li><%= link_to "New", new_task_path, class: "nav-link" %></li>
      <% if current_user.tasks.count > 0 %>
      <li><%= link_to "My Tasks", tasks_path, class: "nav-link" %></li>
      <% end%>

      <li>
        <%= link_to pages_profile_path, class: "card--user" , id: "profile-card" do %>
          <div class="user-avatar-circle">
            <%= render "shared/icons/user" %>
          </div>

          <div class="user-info">
            <span class="user-username"><%=truncate current_user.username, length: 40, separator: '', omission: '...' %></span>
          </div>
        <% end %>
      </li>
    <% else %>
      <li>
        <%= link_to new_user_session_path, class: "card--user" do %>
          <div class="user-avatar-circle">
            <%= render "shared/icons/user" %>
          </div>
          <div class="user-info">
            <span class="user-label">Welcome</span>
            <span class="user-email">Login / Sign up</span>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
