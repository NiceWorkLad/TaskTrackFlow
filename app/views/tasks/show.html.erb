<div class="page-show">
  <% if @showuser %>
  <div class="page-show__task">
    <div class="page-show__main">
      <h1 class="page-show__title wrap-text-word-break"><%= @task.title %></h1>
      <% if @task.body.present? %>
      <div class="page-show__body wrap-text-word-break">
        <%= raw MarkdownRenderer.render(@task.body) %>
      </div>
      <div class="page-show__main-buttons">
        <% end %>
        <% if current_user == @task.user %>
        <%= link_to 'Edit', edit_task_path(@task), class: 'btn-edit' %>
        <% end %>
      </div>
    </div>
    <div class="page-show__details">
      <div class="page-show__creation">
        <p class="page-show__creator wrap-text-word-break" ><span class="page-show__creator-name"><%= @task.user.username %></span></p>
        <p class="page-show__date"><%= @task.created_at.to_date %></p>
      </div>
      <p class="page-show__description wrap-text-word-break"><%= @task.description %></p>
    </div>
    </div>
      <section class="comments-section">
        <div data-controller="visibility">
          <button class="base-btn-2" type="button" data-action="visibility#toggle" data-visibility-targets-param="comment-form-<%= @task.id %>">Comment</button>
          <div id="comment-form-<%= @task.id %>" hidden class="comment-form">
              <%= render  "comments/commentForm", comment: nil %>
          </div>
        </div>
        <% @recentComments.each do |comment| %>
        <div class="comment-box" id="comment_<%= comment.id %>" data-controller="visibility">
          <div class="comment-user">
            <h4 class="comment-username"><%= comment.user.username %></h4>
            <p class="comment-time"><% elapsed_seconds = (Time.current - comment.created_at).to_i %><% if elapsed_seconds < 1.hour %><%= pluralize([elapsed_seconds / 1.minute, 1].max, "min") %> ago<% elsif elapsed_seconds < 1.day %><%= pluralize(elapsed_seconds / 1.hour, "hour") %> ago<% else %><%= pluralize(elapsed_seconds / 1.day, "day") %> ago<% end %></p>
          </div>
          <div class="comment-body">
            <p><%= comment.body %></p>
            <div class="comment-buttons">
              <% if Comment.where(parent_id: comment.id).count > 0 %>
                <button class="base-btn-2-mini" type="button" data-action="visibility#toggle" data-visibility-targets-param="replies-<%= comment.id %>"> <%= Comment.where(parent_id: comment.id).count %> replies</button>
              <% end %>
              <button class="base-btn-2-mini" type="button" data-action="visibility#show" data-visibility-targets-param="comment-form-<%= comment.id %>">Reply</button>
              <% if @currentuser == comment.user %>
                <%= button_to 'Destroy', comment_path(comment), method: :delete, class: 'base-btn-2-mini' %>
              <% end %>
            </div>
          </div>
        </div>
        <div id="comment-form-<%= comment.id %>" hidden class="comment-form">
            <%= render  "comments/replyForm", comment: comment %>
        </div>
        <div id="replies-<%= comment.id %>" hidden>
          <%= render "comments/replies", comment: comment %>
        </div>
      <% end %>
    </section>
  </div>
  <% else %>
  <div class="page-show_task">
    <h2>You do not have permission to view this task</h2>
  </div>
  <% end%>
</div>