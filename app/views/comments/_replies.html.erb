<div data-controller="visibility">
    <section class="reply-section">
        <% Comment.where(parent_id: comment.id).order(created_at: :desc).each do |reply| %>
          <% if @current_user %>
            <%= render "comments/reply", comment: reply %>
          <% else %>
            <%= render "comments/replyGuest", comment: reply %>
          <% end %>
        <% end %>
    </section>
    <%# <button type="button" data-action="visibility#hide" data-visibility-targets-param="replies-comment-id">Hide replies</button> %>
</div>