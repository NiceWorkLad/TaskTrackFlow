<div class="task-list task-display-grid">
  <% tasks.each do |task| %>
    <div class="task-item task-card-grid">
      <%= link_to task_path(task), class: "task-card__link", data: { turbo_frame: "_top" } do %>
        <h2 class="task-card__title"><%= task.title %></h2>
        <time class="task-card__created" datetime="<%= task.created_at.iso8601 %>">Created <%= time_ago_in_words(task.created_at) %> ago</time>
        <time class="task-card__updated" datetime="<%= task.updated_at.iso8601 %>">Last updated <%= time_ago_in_words(task.updated_at) %> ago</time>
        <% if task.due_date.present? %>
          <time class="task-card__due-date" datetime="<%= task.due_date.iso8601 %>">Due in <%= distance_of_time_in_words(Date.today, task.due_date) %></time>
        <% end %>

        <p class="task-card__description"><%= truncate task.description, length: 140, separator: '', omission: '...' %></p>
        <p class="task-card__status <%= task.status %>">
          <%= task.status %>
        </p>
      <% end %>
      <% if current_user && task.user == current_user %>
      <% end %>
    </div>
  <% end %>
</div>
