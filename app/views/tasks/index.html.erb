<h1 class="task-list-title">Task List</h1>
<div class="task-list task-grid">
  <% @tasks.each do |task| %>
    <div class="task-item task-card">
      <%= link_to task_path(task), class: "task-card__link" do %>

        <h2 class="task-card__title"><%= task.title %></h2>
        <p class="task-card__description"><%= task.description %></p>
        <p class="task-card__status <%= task.completed ? 'task-card__status--completed' : 'task-card__status--pending' %>">
          <%= task.completed ? "Completed" : "Pending" %>
        </p>
      <% end %>
      <div class="task-card__actions">
        <%= link_to "Show", task_path(task), class: "btn btn-show" %>
        <%= link_to "Edit", edit_task_path(task), class: "btn btn-edit" %>
      </div>
    </div>
  <% end %>
</div>
