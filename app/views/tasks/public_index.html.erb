<h1 class="task-list-title">Public Task List</h1>
<nav class="view-toggle">
  <%= link_to "Grid",
        url_for(params.permit!.merge(view: "grid")),
        data: { turbo_frame: "tasks_view" },
        class: ("active" if @view_mode == "grid") %>

  <%= link_to "List",
        url_for(params.permit!.merge(view: "list")),
        data: { turbo_frame: "tasks_view" },
        class: ("active" if @view_mode == "list") %>
</nav>


<section class="tasks-index tasks-index--<%= @view_mode %>">
  <%= render "tasks/#{@view_mode}", tasks: @tasks %>
</section>
