<%= link_to 'Back', request.referer || root_path %>
<%= link_to 'Edit', edit_task_path(@task) %>
<%= link_to "Delete",task_path(@task), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>

<h1><%= @task.title %></h1>
<p><%= simple_format(@task.description) %></p>
<% if @task.body.present? %>
  <div class="markdown-explain">
      <a href="https://www.markdownguide.org/getting-started/">?</a>
    </div>
  <div class="markdown-preview">
    <%= raw MarkdownRenderer.render(@task.body) %>
  </div>
<% end %>
<h6><%= @task.status %></h6>
