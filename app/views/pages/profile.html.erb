<% if user_signed_in? %>
  <% user = current_user %>
  <% registration_fields = {
    "User ID" => :id,
    "Username" => :username,
    "Email" => :email,
    "Pending email change" => :unconfirmed_email,
    "Account created" => :created_at,
    "Email confirmed at" => :confirmed_at,
    "Number of tasks" => ->(u) { Task.where(user_id: u.id).count }
  } %>

<div class="card--profile">
  <h1>My Profile</h1>

  <table>
    <tbody>
      <% registration_fields.each do |label, field| %>
        <% value = field.respond_to?(:call) ? field.call(user) : (user.respond_to?(field) ? user.public_send(field) : nil) %>
        <% next if value.blank? %>
        <tr>
          <th style="text-align: left; padding-right: 1rem;"><%= label %>:</th>
          <td class="wrap-text-word-break"><%= value.is_a?(Time) || value.is_a?(DateTime) ? l(value, format: :long) : value %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <hr>
  <h2>Appearance Settings</h2>
  <div class="theme-settings">
    <h3>Change Theme</h3>
    <button data-action="click->theme#toggle" class='base-btn-2'>Toggle theme</button>
  </div>
  <h2>User Settings</h2>
  <div class="username-settings">
    <h3>Change Username</h3>
    <%= form_with(model: user, url: settings_username_path, method: :patch, local: true) do |form| %>
      <div class="field">
        <%= form.label :username %>
        <%= form.text_field :username, value: user.username, class: "form-control" %>
      </div>
      <div class="actions">
        <%= form.submit "Update Username", class: "btn base-btn-2" %>
      </div>
    <% end %>
  </div>
<hr>
  <h2>Email Settings</h2>
  <% if user.email_verified %>
    <p> Email Verified </p>
  <% else %>
    <h4>Email Not Verified<h4>
    <%= link_to "Verify Here", verify_path, class:"base-btn-2" %>
  <% end%>

<%= button_to "Logout", destroy_user_session_path,
    method: :delete,
    class: "base-btn-2" %>


<h3>Cancel my account</h3>

<div>Unhappy With Your account?<%= button_to "Cancel my account", registration_path(user), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, class: "base-btn-2", method: :delete %></div>

<% else %>
  <h1>Profile</h1>
  <p>You must be signed in to view this page.</p>
  <%= link_to "Sign In", new_user_session_path %>
<% end %>
</div>
