<h1 class="task-list-title">Your Task List</h1>
<nav class="view-toggle">
  <%= link_to url_for(params.permit!.merge(view: "grid")),
        data: { turbo_frame: "tasks_view" },
        class: ("active" if @view_mode == "grid") do %>
    Grid
    <%= render "shared/icons/grid" %>
  <% end %>

  <%= link_to url_for(params.permit!.merge(view: "list")),
        data: { turbo_frame: "tasks_view" },
        class: ("active" if @view_mode == "list") do %>
    List
    <%= render "shared/icons/list" %>
  <% end %>
</nav>

  <%# Index layout renderer %>
<section class="tasks-index tasks-index--<%= @view_mode %>">
  <%= render "tasks/#{@view_mode}", tasks: @tasks %>
</section>
