<h1>New Task</h1>

<%= form_with model: @task do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :completed %>
    <%= form.checkbox :completed%>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

<%= link_to "Back to tasks", tasks_path %>
